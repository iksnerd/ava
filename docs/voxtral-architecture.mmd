%%{init: {'theme': 'neutral'}}%%
flowchart TB

    subgraph dictation["Dictation - cmd/ava"]
        mic1[("🎤 Mic")]
        rec["internal/recording<br/>sox, 16kHz mono, norm -3,<br/>stops on silence"]
        wcli["pkg/stt/whisper<br/>exec whisper-cli"]
        model_w[("ggml-base.en.bin<br/>(whisper.cpp, local)")]
        clip["internal/clipboard<br/>pbcopy + AppleScript paste"]

        mic1 --> rec --> wcli
        model_w -.-> wcli
        wcli -->|text| clip
    end

    subgraph realtime["Voxtral MLX primitives"]
        direction TB

        subgraph go_new["pkg/stt/realtime (Go, stdlib only)"]
            grt["StreamRealtime()<br/>long-lived exec realtime.py,<br/>stdout JSON lines"]
        end

        subgraph py_new["voxtral/ (Python uv project, MLX)"]
            hpf["HighPassFilter<br/>(--highpass-hz, default 80Hz)<br/>stateful scipy sosfilt"]
            rt_py["realtime.py<br/>--engine voxtral|whisper<br/>streaming transcribe"]
            diar_py["Sortformer diarization<br/>(--diarize, whisper engine only)"]
        end

        mic3[("🎤 Mic (default)<br/>or BlackHole loopback<br/>(--device, captures call audio<br/>- remote participants only)")]

        mw4brt[("mlx-community/Voxtral-Mini-4B-Realtime-2602-4bit<br/>OR whisper-large-v3-turbo<br/>(--engine, 99+ languages incl. Bulgarian)")]
        mdiar[("mlx-community/<br/>diar_sortformer_4spk-v1-fp32")]

        grt --> rt_py

        mic3 -.->|sd.InputStream, --device| hpf --> rt_py
        rt_py -.->|same filtered chunk| diar_py

        mw4brt -.-> rt_py
        mdiar -.-> diar_py

        rt_py -->|"{event, text, speaker} JSON lines"| grt
        diar_py -.->|speaker label per chunk| rt_py
    end

    subgraph monitor["Realtime call transcript - cmd/ava-monitor"]
        meet["Google Meet<br/>(Settings -> Audio -> Speakers<br/>must be set to the Multi-Output Device<br/>explicitly - doesn't follow macOS<br/>system-default changes automatically)"]
        moutput["Multi-Output Device<br/>(Audio MIDI Setup - use built-in<br/>Speakers, NOT Bluetooth/AirPods,<br/>which silently drop the 2nd member)"]
        blackhole[("BlackHole 2ch<br/>(virtual loopback driver)")]
        speakers[("🔊 Real speakers<br/>(so you still hear the call)")]

        vm["cmd/ava-monitor<br/>net/http + cobra<br/>--diarize, --highpass-hz flags"]
        sse["/events (SSE)"]
        page["/ - live transcript page<br/>(EventSource, auto-updates)"]
        logf[("/tmp/voice-input/<br/>transcript-&lt;ts&gt;.txt<br/>[Speaker N] prefixed on change")]
        browser[("🌐 Browser<br/>127.0.0.1:8766")]

        meet --> moutput
        moutput --> blackhole
        moutput --> speakers
        blackhole -.->|"--device BlackHole"| mic3

        vm -->|StreamRealtime| grt
        grt -->|RealtimeDelta| vm
        vm --> sse --> browser
        vm --> page --> browser
        vm -->|append text| logf
    end

    style dictation fill:#eef2ff,stroke:#4f46e5
    style realtime fill:#ecfdf5,stroke:#059669
    style monitor fill:#ecfdf5,stroke:#059669
