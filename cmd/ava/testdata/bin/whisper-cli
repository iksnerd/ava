#!/bin/sh
# Fixture "whisper-cli" for the CLI tests. It prints nothing, like a run over
# silence or an undecodable file, and with -oj -of it writes the JSON a real
# run would, so a caption format can be checked end to end.
of=""
oj=""
while [ $# -gt 0 ]; do
  case "$1" in
    -oj) oj=1; shift ;;
    -of) of="$2"; shift 2 ;;
    *) shift ;;
  esac
done
if [ -n "$oj" ]; then
  printf '%s' '{"transcription":[{"offsets":{"from":0,"to":1500},"text":" Hello there."}]}' > "$of.json"
fi
# A test can have a plain-text run print something by dropping this file in
# HOME (the engine passes HOME through, not the rest of the environment).
if [ -z "$oj" ] && [ -f "$HOME/fixture-whisper-stdout" ]; then
  cat "$HOME/fixture-whisper-stdout"
fi
# Likewise stderr, for the timing lines a real run ends with.
if [ -f "$HOME/fixture-whisper-stderr" ]; then
  cat "$HOME/fixture-whisper-stderr" >&2
fi
exit 0
