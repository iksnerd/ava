#!/bin/sh
# Fixture "python3" standing in for the voxtral/ venv: dispatches on the
# basename of the script it was asked to run (realtime.py, the only entry
# point pkg/voxtral shells out to).
script="$1"
shift

case "$script" in
  */realtime.py)
    if [ "$1" = "--list-devices" ]; then
      echo "0: Fixture Mic"
      echo "1: BlackHole 2ch"
      exit 0
    fi
    if [ -n "$REALTIME_LOG" ]; then
      printf '%s\n' "$@" > "$REALTIME_LOG"
    fi
    echo '{"event":"ready","device":"fixture-mic","engine":"voxtral"}'
    echo '{"event":"delta","text":"hello "}'
    echo '{"event":"delta","text":"world"}'
    echo '{"event":"done"}'
    ;;
  *)
    echo "fixture python3: unknown script $script" >&2
    exit 1
    ;;
esac
